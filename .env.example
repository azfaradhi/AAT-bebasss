BMKG_PORT=8081
BMKG_API_KEY=replace-with-bmkg-key
BMKG_DELAY_MIN_MS=50
BMKG_DELAY_MAX_MS=150

PVMBG_PORT=8082
PVMBG_JWT_SECRET=replace-with-pvmbg-jwt-secret
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
# generate with: node scripts/mint-pvmbg-token.js
PVMBG_ACCESS_TOKEN=

AGGREGATOR_PORT=8090
POLL_INTERVAL_MS=3000
POLL_LOOKBACK_MS=60000
BMKG_BASE_URL=http://bmkg-mock:8081
PVMBG_BASE_URL=http://pvmbg-mock:8082
SOURCE_REQUEST_TIMEOUT_MS=5000
INTERNAL_SERVICE_KEY=replace-with-internal-service-key
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=10000
PVMBG_MAX_CONCURRENT_CALLS=5
DATABASE_URL=postgres://replace-with-postgres-user:replace-with-postgres-password@postgres:5432/bnpb
POSTGRES_DB=bnpb
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_URL=amqp://replace-with-rabbitmq-user:replace-with-rabbitmq-password@rabbitmq:5672

CLIENT_API_PORT=8080
CLIENT_JWT_SECRET=replace-with-client-jwt-secret
AGGREGATOR_BASE_URL=http://aggregator:8090
AGGREGATOR_REQUEST_TIMEOUT_MS=2000

AUTH_SERVICE_PORT=8091
ACCESS_TOKEN_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=900
AUTH_MEDIA_CLIENT_ID=media-client
AUTH_MEDIA_CLIENT_SECRET=replace-with-media-client-secret
AUTH_LAPANGAN_CLIENT_ID=lapangan-client
AUTH_LAPANGAN_CLIENT_SECRET=replace-with-lapangan-client-secret
AUTH_INTERNAL_CLIENT_ID=internal-client
AUTH_INTERNAL_CLIENT_SECRET=replace-with-internal-client-secret

DASHBOARD_CONSUMER_PORT=8092
NOTIFIER_CONSUMER_PORT=8093
