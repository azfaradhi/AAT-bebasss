# ==============================================================================
# IF4031 Milestone 2 — Sistem Informasi Kebencanaan BNPB (Kelompok bebasss)
# Environment Variables Template (.env.example)
# Copy to .env.local (never committed) and populate real secrets before deploy.
# ==============================================================================

# --- Global & Platform ---
LOG_LEVEL=info
NODE_ENV=production
IMAGE_REGISTRY=node-a:5000
IMAGE_TAG=m2
PRESTOP_DRAIN_SECONDS=10
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318

# --- M1-era Mock Sources (BMKG & PVMBG) ---
BMKG_PORT=8081
BMKG_HOST=0.0.0.0
BMKG_SEED_INTERVAL_MS=15000
BMKG_FAULT_RATE=0.0
BMKG_FAULT_DELAY_MS=0
BMKG_DUPLICATE_RATE=0.0

PVMBG_PORT=8082
PVMBG_JWT_SECRET=replace-with-pvmbg-jwt-secret
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
PVMBG_LIVE_INTERVAL_MS=10000
# generate with: node scripts/mint-pvmbg-token.js
PVMBG_ACCESS_TOKEN=
PVMBG_HOST=0.0.0.0
PVMBG_SEED_INTERVAL_MS=20000
PVMBG_FAULT_RATE=0.0
PVMBG_FAULT_DELAY_MS=0
PVMBG_DUPLICATE_RATE=0.0

# --- Aggregator Core & Polling ---
AGGREGATOR_PORT=8090
AGGREGATOR_HOST=0.0.0.0
BMKG_BASE_URL=http://bmkg-mock:8081
PVMBG_BASE_URL=http://pvmbg-mock:8082
POLL_INTERVAL_BMKG_MS=5000
POLL_INTERVAL_PVMBG_MS=7000
HTTP_TIMEOUT_MS=3000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=200
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=15000
MAX_CONCURRENT_REQUESTS=5
OUTBOX_DISPATCH_INTERVAL_MS=500

# --- Problem 1 & 2: Distributed Storage Ring & Leader Coordination ---
STORAGE_PEERS=http://storage-unit-node-a:8100,http://storage-unit-node-b:8100,http://storage-unit-node-c:8100
STORAGE_RF=2
STORAGE_TIMEOUT_MS=2000
STORAGE_WRITE_QUORUM=2
STORAGE_READ_QUORUM=1
STORAGE_UNIT_PORT=8100
STORAGE_DATA_DIR=/var/lib/bnpb/store
STORAGE_REPAIR_INTERVAL_MS=5000

LEASE_NAMESPACE=sistem-informasi-kebencanaan-bnpb
LEASE_DURATION_SECONDS=10
LEASE_RENEW_INTERVAL_MS=3000

# --- Problem 3: Poison-Pill Guard, Quarantine & Parking ---
MAX_MESSAGE_BYTES=262144
MAX_JSON_DEPTH=32
MAX_PARK_RAW_BYTES=1048576
PARK_MAX_ATTEMPTS=8

# --- Problem 4: Satellite Stream (VIIRS) & Fire Recognition ---
SAT_PROCESSOR_PORT=8094
SAT_FEED_URL=https://if4031-satelit.External-Endpoint.example/v1/stream
SAT_AUTH_TOKEN=replace-with-sat-auth-token
SAT_SPATIAL_EPS_KM=2.5
SAT_TEMPORAL_WINDOW_HOURS=6
SAT_LATE_WINDOW_HOURS=24

# --- Problem 5: Sensor Pantai, Resilience, Admission Control & Critical Alerts ---
PANTAI_BASE_URL=http://sensor-pantai:8080
PANTAI_AUTH_TOKEN=replace-with-pantai-token
PANTAI_POLL_INTERVAL_MS=2000
PANTAI_TIMEOUT_MS=2500
PANTAI_MAX_STALENESS_S=3600
PANTAI_PROFILE=practice
PANTAI_SPEED=60

BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=10000
BREAKER_HALF_OPEN_MAX_PROBES=1
BULKHEAD_MAX_CONCURRENT=4
BULKHEAD_MAX_QUEUE=8

ADMISSION_MAX_INFLIGHT=64
ADMISSION_LAPANGAN_RESERVED=16
ADMISSION_MEDIA_MAX_INFLIGHT=24
ADMISSION_RETRY_AFTER_S=3

# --- RabbitMQ Broker (3-Pod Quorum Queue HA Cluster) ---
RABBITMQ_URL=amqp://bnpb:replace-with-rabbitmq-password@rabbitmq:5672
RABBITMQ_DEFAULT_USER=bnpb
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password
RABBITMQ_ERLANG_COOKIE=replace-with-erlang-cluster-cookie

# --- Auth Service & Client-Facing API ---
AUTH_PORT=8091
AUTH_HOST=0.0.0.0
JWT_SECRET=replace-with-jwt-hmac-secret-at-least-32-chars
JWT_ISSUER=bnpb-auth-service
JWT_AUDIENCE=bnpb-hazard-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=86400
JWT_CLOCK_TOLERANCE_S=60

# Required (no built-in defaults): the services refuse to start without these.
CLIENT_JWT_SECRET=replace-with-client-jwt-secret
INTERNAL_SERVICE_KEY=replace-with-internal-service-key
NOTIFIER_BASE_URL=http://notifier:8093

CLIENT_API_PORT=8080
CLIENT_API_HOST=0.0.0.0
AGGREGATOR_BASE_URL=http://aggregator:8090
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Audit API (Lampiran A) ---
AUDIT_TOKEN=replace-with-audit-token

DASHBOARD_CONSUMER_PORT=8092
NOTIFIER_CONSUMER_PORT=8093

# Ingest guards / parking (aggregator)
MAX_MESSAGE_BYTES=262144
MAX_JSON_DEPTH=32
PARK_MAX_ATTEMPTS=8

# Satellite processor
SAT_FEED_BASE_URL=http://feed-fixture-server:8099
SAT_GROUP_TOKEN=replace-with-group-token
SAT_ALLOWED_LATENESS_MIN=360
SAT_FLUSH_INTERVAL_MS=250
SAT_WRITE_CONCURRENCY=32
SAT_CHECKPOINT_EVERY_N=100
SAT_BATCH_SIZE=500
SAT_IDLE_TIMEOUT_MS=30000
SAT_RECONNECT_MIN_MS=200
SAT_RECONNECT_MAX_MS=15000
SAT_SESSION_POLL_MS=5000
SATELLITE_PORT=8094

# Mapper version for PVMBG records: v1 = declared policy, v2 also understands renamed / numeric-string fields (aggregator)
VOLCANIC_MAPPER_VERSION=v1

# Field report processor
SWEEP_INTERVAL_MS=200
RECONCILE_INTERVAL_MS=60000
FIELD_REPORT_PORT=8095

# Advisor (bonus): optional; with no key it runs in template-only mode. Put the real key in .env.local only.
ADVISOR_PORT=8097
ADVISOR_POLL_MS=30000
ADVISOR_LLM_BASE_URL=https://api.groq.com/openai/v1
ADVISOR_LLM_MODEL=openai/gpt-oss-20b
ADVISOR_LLM_TIMEOUT_MS=5000
ADVISOR_LLM_RATE_PER_MIN=20
ADVISOR_QUEUE_MAX=100
ADVISOR_BREAKER_FAILURES=5
ADVISOR_BREAKER_COOLDOWN_MS=60000
GROQ_API_KEY=replace-with-your-groq-key
# --- Consumers & Analytics Dashboard ---
DASHBOARD_UPDATER_PORT=8092
DASHBOARD_UPDATER_HOST=0.0.0.0
NOTIFIER_PORT=8093
NOTIFIER_HOST=0.0.0.0
FIELD_REPORT_PROCESSOR_PORT=8095
ANALYTICS_DASHBOARD_PORT=8110
