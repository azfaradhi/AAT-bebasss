# ==============================================================================
# Local / Dev Secrets Template (.env.local.example)
# Copy this file to .env.local (`cp .env.local.example .env.local`) before running
# `make secrets` or `make up`. .env.local is git-ignored.
# ==============================================================================

CLIENT_JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars!!
AUDIT_TOKEN=dev-audit-token-bnpb-m2
PANTAI_AUTH_TOKEN=dev-pantai-token-bnpb-m2
SAT_AUTH_TOKEN=dev-sat-token-bnpb-m2
RABBITMQ_DEFAULT_USER=bnpb
RABBITMQ_DEFAULT_PASS=bnpb-secret-pass
RABBITMQ_ERLANG_COOKIE=bnpb-erlang-cluster-cookie-m2
RABBITMQ_URL=amqp://bnpb:bnpb-secret-pass@rabbitmq:5672
IMAGE_REGISTRY=localhost:5050
IMAGE_TAG=m2

# Dev-only placeholder credentials (replace for the demo; never commit .env.local)
BMKG_API_KEY=dev-bmkg-key
PVMBG_JWT_SECRET=dev-pvmbg-jwt-secret
INTERNAL_SERVICE_KEY=dev-internal-service-key
AUTH_MEDIA_CLIENT_ID=media-client
AUTH_MEDIA_CLIENT_SECRET=media-secret
AUTH_LAPANGAN_CLIENT_ID=lapangan-client
AUTH_LAPANGAN_CLIENT_SECRET=lapangan-secret
AUTH_INTERNAL_CLIENT_ID=internal-client
AUTH_INTERNAL_CLIENT_SECRET=internal-secret
